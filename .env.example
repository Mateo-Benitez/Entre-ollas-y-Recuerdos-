# Copiá este archivo como .env y completá los valores.
PORT=3000
# En producción (con HTTPS) usá: NODE_ENV=production
NODE_ENV=development
# Carpeta donde se guardan la base de datos y las fotos (debe ser persistente)
DATA_DIR=./data
TIMEZONE=America/Argentina/Buenos_Aires
# Poné 1 si la app corre detrás de un proxy (Nginx, Render, Railway…)
TRUST_PROXY=0
# Crean el primer administrador al iniciar, solo si todavía no existe ninguno.
# Borralas después del primer inicio.
ADMIN_USER=
ADMIN_PASSWORD=
